# Copy to .env and fill in. docker compose reads .env from this directory.
#
#   cp .env.example .env
#
# Never commit the filled-in .env: it holds the key your secrets are encrypted
# with. .gitignore already excludes it.

# --- required ---------------------------------------------------------------

# The database password. Any strong value; nothing else needs to know it.
POSTGRES_PASSWORD=

# The key secret values are encrypted with at rest. Generate one with:
#
#   docker run --rm ghcr.io/clement880101/secret-manager:latest \
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Keep a copy somewhere safe. Lose it and the stored secrets cannot be read.
# Leave it empty and values are stored in plaintext.
SECRET_ENCRYPTION_KEY=

# --- required for the clustered deployment only -----------------------------

# Every replica must agree on the first token, or each mints its own on the way
# up and only one of them is the one you were shown. Any long random string:
#
#   python -c "import secrets; print('smt_' + secrets.token_urlsafe(32))"
#
# Not needed for the single-container setup, which prints a token on first run.
BOOTSTRAP_TOKEN=

# --- optional ---------------------------------------------------------------

POSTGRES_USER=secretmgr
POSTGRES_DB=secretmgr

# Host port for the API in the single-node setup.
API_PORT=8000

# false closes public signup, so accounts are only created with `secretmgr token`.
ALLOW_REGISTRATION=true

# Serve /docs and /openapi.json. Off by default.
ENABLE_API_DOCS=false

# Browser origins allowed to call the API. Comma-separated; empty allows none.
ALLOWED_ORIGINS=

# Usernames that may read the whole audit trail rather than only their own.
ADMIN_USERS=

# Tokens expire after this many days. 0 means never.
TOKEN_TTL_DAYS=0

# Audit events are dropped after this many days. 0 keeps them.
AUDIT_RETENTION_DAYS=0

# Failed logins allowed per window, per account, shared across replicas.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300

# Largest request body accepted, in bytes.
MAX_REQUEST_BYTES=131072

# During a key rotation, the previous key(s), comma-separated. They can still
# decrypt; new writes use SECRET_ENCRYPTION_KEY. Remove once `rotate_keys`
# reports nothing remaining.
SECRET_ENCRYPTION_KEYS_RETIRED=
