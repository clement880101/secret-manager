# Copy to .env and fill in. Never commit the result.

# Database
POSTGRES_USER=secretmgr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secretmgr

# Encrypts secret values at rest. Generate with:
#   docker run --rm ghcr.io/clement880101/secret-manager:latest \
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this makes existing encrypted values unreadable.
SECRET_ENCRYPTION_KEY=

# GitHub OAuth app (https://github.com/settings/developers).
# Set its callback URL to  <BACKEND_URL>/auth/callback
OAUTH_ID_GITHUB=
OAUTH_SECRET_GITHUB=

# The URL clients actually reach, including scheme. GitHub redirects here after
# login, so it must match your public address, not the container's.
BACKEND_URL=http://localhost:8000

# Optional
API_PORT=8000
ENABLE_API_DOCS=false
ENABLE_TEST_LOGIN=false
ALLOWED_ORIGINS=
